APP_MODE=production
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Local persistent database. For hosted MySQL use mysql+pymysql://user:password@host:3306/stockai
DATABASE_URL=sqlite:///stockai.db
MARKET_DATA_PROVIDER=yfinance
# Use only with a fresh token in the server environment. Never use a VITE_ variable.
GROWW_API_TOKEN=
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:5000
