{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,frontend/**,node_modules/**,dist/**,data/**,ml/**,models/**,*.png,*.md,README*,package*,vite.config.js,index.html,.env,.env.example,requirements-research.txt}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.py" }, { "source": "/(.*)", "destination": "/index.html" }]
}
